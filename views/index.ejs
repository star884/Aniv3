<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Stremio Powered Anime Web App</title>
    <style>
        body { background: #0f1115; color: #fff; font-family: sans-serif; padding: 20px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; margin-bottom: 40px; }
        .card { background: #1c1f26; border-radius: 8px; overflow: hidden; text-decoration: none; color: white; transition: 0.2s; }
        .card:hover { transform: translateY(-5px); }
        .card img { width: 100%; height: 260px; object-fit: cover; }
        .card-info { padding: 10px; font-size: 14px; text-align: center; }
        h2 { border-bottom: 2px solid #323846; padding-bottom: 5px; color: #ff5e00; }
        .timestamp { color: #888; font-size: 12px; }
    </style>
</head>
<body>
    <h1>Automated Anime Portal</h1>
    <p class="timestamp">Database Refreshed Dynamically: <%= library.lastUpdated %></p>

    <h2>🔥 Trending Releases</h2>
    <div class="grid">
        <% library.trending.forEach(item => { %>
            <a class="card" href="/anime/<%= item.id %>">
                <img src="<%= item.poster %>" alt="<%= item.name %>">
                <div class="card-info"><strong><%= item.name %></strong></div>
            </a>
        <% }) %>
    </div>

    <h2>⭐ Most Popular All-Time</h2>
    <div class="grid">
        <% library.popular.forEach(item => { %>
            <a class="card" href="/anime/<%= item.id %>">
                <img src="<%= item.poster %>" alt="<%= item.name %>">
                <div class="card-info"><strong><%= item.name %></strong></div>
            </a>
        <% }) %>
    </div>
</body>
</html>
